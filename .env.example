# Local Docker development environment variables.
# Copy this file to .env and adjust values for your machine:
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=modular_monolith
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_postgres_password_change_me
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Docker

# JWT / refresh (replace with long random strings in real use)
JWT_SECRET=dev_jwt_secret_change_me_min_32_characters_long
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_min_32_chars

# Admin seed (first-run identity seeder)
ADMIN_SEED_USER=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=Admin@123456

# Email (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_TEST_MODE_REDIRECT=dev@example.com

# Hangfire dashboard basic auth (local Docker only)
HANGFIRE_DASHBOARD_USER=hangfire
HANGFIRE_DASHBOARD_PASSWORD=dev_hangfire_password_change_me

# Optional pgAdmin (docker compose --profile tools up)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=dev_pgadmin_password_change_me
