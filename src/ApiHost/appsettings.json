{
  "HealthChecks": {
    "Enabled": true,
    "DetailsEnabled": true,
    "TimeoutSeconds": 5,
    "Tags": {
      "Live": ["live"],
      "Ready": ["ready"],
      "Dependency": ["dependency"]
    }
  },
  "Monitoring": {
    "EnableRequestLogging": true,
    "EnableCorrelationId": true,
    "SlowRequestThresholdMs": 1000,
    "IncludeRequestBody": false,
    "IncludeResponseBody": false
  },
  "Swagger": {
    "Enabled": false
  },
  "SecurityHeaders": {
    "Enabled": true,
    "EnableStrictTransportSecurity": false,
    "EnableContentSecurityPolicy": true
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Authorization", "Content-Type", "X-Correlation-Id"],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "Enabled": true,
    "GeneralPermitLimit": 120,
    "GeneralWindowSeconds": 60,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 10,
    "RefreshWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "FileUploadPermitLimit": 20,
    "FileUploadWindowSeconds": 60,
    "BackgroundJobsPermitLimit": 10,
    "BackgroundJobsWindowSeconds": 60
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "ModularMonolith:"
    },
    "DefaultExpirationMinutes": 30,
    "UserPermissionsExpirationMinutes": 20,
    "KeyPrefix": "modular-monolith",
    "EnableLogging": true,
    "FailFastOnRedisUnavailableInProduction": true,
    "FallbackToMemoryInDevelopment": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=modular_monolith;Username=postgres;Password=CHANGE_ME"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "FailStartupOnMigrationError": true
  },
  "Jwt": {
    "Issuer": "ModularApi",
    "Audience": "ModularApiClient",
    "Secret": "CHANGE_ME_TO_A_LONG_SECURE_SECRET_KEY_32_CHARS_MIN",
    "AccessTokenExpirationMinutes": 30
  },
  "RefreshToken": {
    "Secret": "CHANGE_ME_TO_A_LONG_REFRESH_TOKEN_SECRET_32_CHARS_MIN",
    "ExpirationDays": 7
  },
  "AdminSeed": {
    "Enabled": true,
    "UserName": "admin",
    "Email": "admin@example.com",
    "FullName": "System Administrator",
    "Password": "CHANGE_ME"
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "uploads",
      "PublicBaseUrl": ""
    },
    "MaxFileSizeMb": 20,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf",
      ".docx",
      ".xlsx",
      ".csv"
    ],
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/csv"
    ]
  },
  "BackgroundJobs": {
    "Enabled": true,
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "BasicAuth": {
        "Enabled": false,
        "UserName": "",
        "Password": ""
      }
    },
    "Schedules": {
      "EmailRetryCron": "*/5 * * * *",
      "TemporaryFileCleanupCron": "0 * * * *",
      "LogCleanupCron": "0 2 * * *"
    },
    "EmailRetry": {
      "BatchSize": 50,
      "MaxRetryCount": 5
    },
    "TemporaryFiles": {
      "BatchSize": 100,
      "DeletePhysicalFiles": true
    },
    "LogCleanup": {
      "Enabled": false,
      "RetentionDays": 90
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "Modular API",
    "FromAddress": "noreply@example.com",
    "Smtp": {
      "Host": "localhost",
      "Port": 587,
      "UserName": "",
      "Password": "",
      "EnableSsl": true,
      "UseDefaultCredentials": false
    },
    "TestMode": {
      "Enabled": false,
      "RedirectTo": ""
    }
  },
  "LoggingOptions": {
    "EnableRequestBodyLogging": false,
    "EnableResponseBodyLogging": false,
    "MaxBodyLogSize": 4096,
    "ExcludedPaths": [
      "/health",
      "/health/live",
      "/health/ready",
      "/api/v1/monitoring",
      "/swagger",
      "/favicon.ico"
    ],
    "SensitiveFields": [
      "password",
      "passwordHash",
      "accessToken",
      "refreshToken",
      "token",
      "secret",
      "authorization",
      "cookie",
      "set-cookie",
      "otp",
      "privateKey"
    ],
    "SensitiveHeaders": [
      "Authorization",
      "Cookie",
      "Set-Cookie"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [CorrelationId:{CorrelationId}] [UserId:{UserId}] [Method:{Method}] [Path:{Path}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [CorrelationId:{CorrelationId}] [UserId:{UserId}] [Method:{Method}] [Path:{Path}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
