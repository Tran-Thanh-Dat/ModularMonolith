{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=modular_monolith_dev;Username=postgres;Password=CHANGE_ME"
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5080"]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "FailStartupOnMigrationError": true
  },
  "LoggingOptions": {
    "EnableRequestBodyLogging": true,
    "EnableResponseBodyLogging": true,
    "MaxBodyLogSize": 4096
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "Modular API (Dev)",
    "FromAddress": "noreply@example.com",
    "Smtp": {
      "Host": "localhost",
      "Port": 587,
      "UserName": "",
      "Password": "",
      "EnableSsl": true,
      "UseDefaultCredentials": false
    },
    "TestMode": {
      "Enabled": true,
      "RedirectTo": "dev-inbox@example.com"
    }
  },
  "AdminSeed": {
    "Enabled": true,
    "Password": "Admin@123456"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
