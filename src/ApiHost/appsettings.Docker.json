{
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "FailStartupOnMigrationError": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5080"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=modular_monolith;Username=postgres;Password=dev_postgres_password_change_me"
  },
  "Cache": {
    "Provider": "Redis",
    "Redis": {
      "ConnectionString": "redis:6379",
      "InstanceName": "ModularMonolith:"
    },
    "FailFastOnRedisUnavailableInProduction": false,
    "FallbackToMemoryInDevelopment": false
  },
  "Jwt": {
    "Issuer": "ModularApi",
    "Audience": "ModularApiClient",
    "Secret": "dev_jwt_secret_change_me_min_32_characters_long",
    "AccessTokenExpirationMinutes": 30
  },
  "RefreshToken": {
    "Secret": "dev_refresh_secret_change_me_min_32_chars",
    "ExpirationDays": 7
  },
  "AdminSeed": {
    "UserName": "admin",
    "Email": "admin@example.com",
    "FullName": "System Administrator",
    "Password": "Admin@123456"
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "uploads",
      "PublicBaseUrl": ""
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "BasicAuth": {
        "Enabled": true,
        "UserName": "hangfire",
        "Password": "dev_hangfire_password_change_me"
      }
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "Modular API (Docker)",
    "FromAddress": "noreply@example.com",
    "Smtp": {
      "Host": "mailpit",
      "Port": 1025,
      "UserName": "",
      "Password": "",
      "EnableSsl": false,
      "UseDefaultCredentials": false
    },
    "TestMode": {
      "Enabled": true,
      "RedirectTo": "dev@example.com"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailsEnabled": true
  },
  "Monitoring": {
    "EnableRequestLogging": true,
    "EnableCorrelationId": true
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
